		{"id":"4a407c9cae89ab9f","type":"text","text":"Agrupación por tópicos y temporalidad","x":920,"y":-272,"width":250,"height":60},
		{"id":"430fa72a0c6c566c","type":"text","text":"Agregación temporal, (frecuencias relativas)","x":531,"y":49,"width":250,"height":60},
